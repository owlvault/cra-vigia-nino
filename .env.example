# =============================================================================
# Plantilla de Variables de Entorno — Vigía El Niño · Acueductos (CRA)
# Copie este archivo a `.env` y configure los valores reales según su entorno.
# NUNCA confirme el archivo `.env` en el control de versiones Git.
# =============================================================================

# --- 1. Servidor Web del Tablero (servidor_tablero.py) ---
# Puerto de escucha local del servidor HTTP (por defecto: 8088)
PORT=8088

# Token de autorización administrativa para disparar actualizaciones manuales
# vía POST /api/semanal/actualizar (dejar vacío solo en desarrollo local aislado)
VIGIA_ADMIN_TOKEN=reemplazar_con_token_secreto_seguro

# --- 2. Conectores de Datos Abiertos (Socrata / datos.gov.co) ---
# App Token oficial de Socrata para elevar cuotas de consulta en IDEAM, SIVICAP y UNGRD
SOCRATA_APP_TOKEN=

# Ruta opcional a certificado CA raíz institucional si opera detrás de proxy SSL
CRA_CA_BUNDLE_PATH=

# --- 3. Conector NASA FIRMS (Focos de Calor VIIRS 375m) ---
# Llave de API de NASA Earthdata FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# --- 4. Bodega Institucional SUI / SSPD (Oracle Directo - Opcional) ---
SUI_ORACLE_DSN=sui-scan.sspd.gov.co:1521/SUIPRD
SUI_ORACLE_USER=
SUI_ORACLE_PASSWORD=

